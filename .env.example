APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: pgsql or mysql (both supported). For zero-install local dev, use sqlite
# and create the database file: touch database/database.sqlite
# PostgreSQL (preferred): port 5432, e.g. DB_USERNAME=postgres
# MySQL (fallback when PostgreSQL not on host): port 3306, e.g. DB_USERNAME=root
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gedms
DB_USERNAME=postgres
DB_PASSWORD=

# Dormant connection "gba_file_manager" (config/database.php) - not used by app code
# DB_GBA_HOST=127.0.0.1
# DB_GBA_PORT=3306
# DB_GBA_DATABASE=gba_file_manager
# DB_GBA_USERNAME=root
# DB_GBA_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Resumable large-file uploads (config/uploads.php)
# Total size of one file; server request limits only need to cover one chunk.
UPLOAD_MAX_BYTES=10737418240
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_TTL_HOURS=48
UPLOAD_QUEUE_CONNECTION=uploads
UPLOAD_QUEUE=uploads
UPLOAD_QUEUE_RETRY_AFTER=3600

# Where the upload bytes live: local | s3 | dropbox.
# local   = the "edms" disk on this machine
# s3      = any S3-compatible bucket (AWS, MinIO, R2, Spaces, Wasabi)
# dropbox = a folder in a Dropbox account, through the Dropbox API
UPLOAD_STORAGE_DRIVER=local
UPLOAD_LOCAL_DISK=edms
UPLOAD_CLOUD_DISK=edms-cloud

# Optional application-level quota, in bytes. Used by the storage usage panel
# when the provider does not report its own allocation (S3 has no quota API).
UPLOAD_QUOTA_BYTES=

# Simulated cloud faults (see docs/cloud-storage-test-plan.md).
# Every value is off by default, so normal uploads are unaffected.
UPLOAD_FAULT_LATENCY_MS=0
UPLOAD_FAULT_JITTER_MS=0
UPLOAD_FAULT_BANDWIDTH_BPS=
UPLOAD_FAULT_FAILURE_RATE=0
UPLOAD_FAULT_DROP_AFTER_BYTES=
UPLOAD_FAULT_QUOTA_EXCEEDED=false
UPLOAD_FAULT_EVENTUAL_CONSISTENCY_READS=0

# Dropbox driver (UPLOAD_STORAGE_DRIVER=dropbox).
# The refresh token is long-lived; the access token is renewed and cached.
# When connecting from the admin UI, only the app key and secret are required:
# the refresh token is obtained through the OAuth callback.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Docker-style secret mounts, taking precedence over the values above.
DROPBOX_APP_KEY_FILE=
DROPBOX_APP_SECRET_FILE=
DROPBOX_REFRESH_TOKEN_FILE=
DROPBOX_ROOT=/edms
DROPBOX_TIMEOUT=120
# Exact callback URL registered on the Dropbox app. Leave empty to derive it
# from the named callback route (admin.storage-spaces.external-storage.oauth.callback).
# Register the exact scheme, host, port and path; production should use HTTPS.
DROPBOX_REDIRECT_URI=

# Google Drive (OAuth app from Google Cloud Console).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT=/edms
GOOGLE_DRIVE_REDIRECT_URI=

# Microsoft OneDrive (app registration in Microsoft Entra).
# ONEDRIVE_TENANT=common works for personal accounts; use a tenant id/domain for
# an organisation that restricts the app.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REFRESH_TOKEN=
ONEDRIVE_TENANT=common
ONEDRIVE_ROOT=/edms
ONEDRIVE_REDIRECT_URI=

VITE_APP_NAME="${APP_NAME}"
